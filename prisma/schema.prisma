generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlanJob {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  input     Json?
  plan      Json?
  status    String   @default("draft")

  @@map("planjob")
}

model EmailOtp {
  email     String   @id
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique(map: "Session_tokenHash_key")
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email], map: "Session_email_idx")
  @@map("session")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings            LicenseBinding[]
  organizationMembers OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  projects      Project[]
  quotes        Quote[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  invoices      SaasInvoice[]
  payments      Payment[]
  crmCustomers  Customer[]

  @@map("organization")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

model LicenseBinding {
  userId      String
  licenseId   String
  fingerprint String?
  createdAt   DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  license LicenseKey @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([userId, licenseId])
  @@index([userId])
  @@index([licenseId])
}

model Order {
  id        String   @id @default(cuid())
  planId    String
  email     String?
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([email])
  @@map("order")
}

model LicenseKey {
  id           String    @id @default(cuid())
  keyHash      String    @unique
  planId       String?
  maxDownloads Int       @default(0)
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  requireLogin Boolean   @default(false)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  planLevel    String    @default("pro")
  bindings     LicenseBinding[]
}

model PdfDownloadLog {
  id            String   @id @default(cuid())
  planId        String
  ip            String?
  ok            Boolean
  reason        String?
  createdAt     DateTime @default(now())
  error         String?
  userAgent     String?
  route         String   @default("/api/pdf")
  method        String   @default("GET")
  mode          String?
  level         String?
  format        String?
  theme         String?
  pdfVersion    String?
  planVersion   String?
  budgetVersion String?
  reqsig        String?
  docSeq        String?
  pages         Int?
  bytes         Int?
  ua            String?
  extra         Json?

  @@index([planId, createdAt])
  @@index([createdAt])
}

model LicenseConsume {
  id          String   @id @default(cuid())
  licenseId   String
  planId      String
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([licenseId, fingerprint])
  @@index([planId, createdAt])
}

model PdfDownloadTokenDeny {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  planId    String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

model PdfDownloadTokenState {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  planId    String
  mode      String?
  expAt     DateTime
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, createdAt])
  @@index([revoked, expAt])
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  company   String?
  name      String?
  title     String?
  planId    String?
  intent    String
  source    String   @default("download")
  status    String   @default("new")
  score     Int      @default(0)
  note      String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([planId, createdAt])
  @@index([status])
}

model EmailVerifyCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  mode      String
  planId    String
  /// 商业模式：free / pro / enterprise，与签发 unlockToken.planLevel 对齐
  planLevel String    @default("pro")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, mode, planId, planLevel])
  @@index([expiresAt])
}

model DownloadLead {
  id           String    @id @default(cuid())
  email        String
  planId       String
  mode         String
  verifiedAt   DateTime?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([planId])
  @@index([mode])
}

model UnlockIntent {
  id        String   @id @default(cuid())
  planId    String
  createdAt DateTime @default(now())
  ip        String?
  ua        String?

  @@index([planId])
  @@index([createdAt])
}

/// 套餐升级订单（支付：pending → paid | failed | canceled）
/// status：pending | paid | failed | canceled（小写，与 API 一致）
model UpgradeOrder {
  id                String   @id @default(cuid())
  planId            String
  projectId         String?
  targetLevel       String
  status            String   @default("pending")
  amount            Int
  userId            String?
  clientFingerprint String?
  paymentProvider   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([planId, createdAt])
  @@index([status])
  @@map("upgrade_order")
}

model Project {
  id             String               @id @default(cuid())
  name           String
  clientName     String?
  industry       String?
  siteType       SiteType
  areaM2         Float?
  targetUsers    Int?
  city           String?
  budgetLevel    BudgetLevel
  deliveryMode   DeliveryMode
  notes          String?
  organizationId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  description    String?
  budgets        Budget[]
  documents      DocumentExport[]
  placeholders   ProductPlaceholder[]
  solution       Solution?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  quotes         Quote[]
  tenders        Tender[]
}

model Solution {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  summary            String
  background         String
  requirements       Json
  objectives         Json
  zoning             Json
  implementationPlan Json
  operationsPlan     Json
  riskControl        Json
  acceptanceCriteria Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProductPlaceholder {
  id                   String      @id @default(cuid())
  projectId            String
  category             String
  subCategory          String?
  specTags             Json
  quantity             Int
  priceBand            PriceBand
  recommendationReason String
  replaceable          Boolean     @default(true)
  skuId                String?
  skuName              String?
  brand                String?
  model                String?
  imageUrl             String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skuMapping           SkuMapping?
}

model Budget {
  id               String   @id @default(cuid())
  projectId        String
  currency         String   @default("CNY")
  totalEstimateMin Float
  totalEstimateMax Float
  items            Json
  assumptions      Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenders          Tender[]
}

model DocumentExport {
  id            String       @id @default(cuid())
  projectId     String
  docType       DocumentType
  fileName      String
  fileUrl       String?
  renderVersion String
  metadata      Json?
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkuMapping {
  id            String             @id @default(cuid())
  placeholderId String             @unique
  skuId         String
  skuName       String
  brand         String?
  model         String?
  imageUrl      String?
  unitPrice     Float?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  placeholder   ProductPlaceholder @relation(fields: [placeholderId], references: [id], onDelete: Cascade)
}

enum SiteType {
  office
  factory
  park
  school
  hospital
  mixed
}

enum BudgetLevel {
  low
  mid
  high
  custom
}

enum DeliveryMode {
  standard
  enterprise
  tender
}

enum PriceBand {
  low
  mid
  high
}

enum DocumentType {
  plan
  budget
  merged
  zip
  tender
}

/// V59 — Quote record (Product layer, orchestrated via V58)
model Quote {
  id              String       @id @default(cuid())
  projectId       String
  organizationId  String?
  workspaceId     String
  status          QuoteStatus  @default(DRAFT)
  companyInfo     Json?
  content         Json?
  orchestrationId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  tenders      Tender[]

  @@index([projectId])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("quote")
}

/// V59 — Tender document record (PDF export target)
model Tender {
  id            String       @id @default(cuid())
  projectId     String
  quoteId       String?
  budgetId      String?
  status        TenderStatus @default(PENDING)
  fileName      String?
  fileUrl       String?
  renderVersion String       @default("v59-1")
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote   Quote?  @relation(fields: [quoteId], references: [id])
  budget  Budget? @relation(fields: [budgetId], references: [id])

  @@index([projectId])
  @@index([quoteId])
  @@map("tender")
}

enum QuoteStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum TenderStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// V59 SaaS — Subscription
model Subscription {
  id                   String        @id @default(cuid())
  organizationId       String
  plan                 SaasPlan      @default(BASIC)
  status               SaasSubStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     SaasInvoice[]

  @@index([organizationId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscription")
}

/// V59.4 — Stripe Payment record
model Payment {
  id              String   @id @default(cuid())
  organizationId  String
  stripeSessionId String   @unique
  amount          Int
  currency        String   @default("usd")
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("payment")
}

/// V59.4 — Idempotent Stripe webhook processing
model StripeWebhookEvent {
  stripeEventId String   @id
  eventType     String
  processedAt   DateTime @default(now())

  @@map("stripe_webhook_event")
}

/// V59 SaaS — Usage tracking
model UsageRecord {
  id             String        @id @default(cuid())
  organizationId String
  type           UsageType
  count          Int           @default(1)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@map("usage_record")
}

/// V59 SaaS — Invoice
model SaasInvoice {
  id              String   @id @default(cuid())
  organizationId  String
  subscriptionId  String?
  amount          Int
  currency        String   @default("usd")
  status          String   @default("DRAFT")
  stripeInvoiceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId])
  @@map("saas_invoice")
}

enum SaasPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SaasSubStatus {
  ACTIVE
  CANCELED
}

enum UsageType {
  QUOTE
  BUDGET
  TENDER
  PDF
}

/// V60 P2 — CRM Customer
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String   @default("")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads         CrmLead[]
  opportunities Opportunity[]
  activities    CRMActivity[]

  @@index([organizationId])
  @@map("crm_customer")
}

/// V60 P2 — CRM Lead
model CrmLead {
  id         String   @id @default(cuid())
  customerId String
  source     String   @default("unknown")
  score      Int      @default(0)
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("crm_lead")
}

/// V60 P2 — CRM Opportunity
model Opportunity {
  id         String   @id @default(cuid())
  customerId String
  leadId     String?
  stage      String   @default("INIT")
  value      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([customerId])
  @@index([stage])
  @@map("crm_opportunity")
}

/// V60 P2 — CRM Deal
model Deal {
  id            String   @id @default(cuid())
  opportunityId String
  amount        Int      @default(0)
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([status])
  @@map("crm_deal")
}

/// V60 P2 — CRM Activity
model CRMActivity {
  id         String   @id @default(cuid())
  customerId String
  type       String
  meta       Json?
  timestamp  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, timestamp])
  @@map("crm_activity")
}
