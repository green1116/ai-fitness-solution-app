generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlanJob {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  input     Json?
  plan      Json?
  status    String   @default("draft")

  @@map("planjob")
}

model EmailOtp {
  email     String   @id
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique(map: "Session_tokenHash_key")
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email], map: "Session_email_idx")
  @@map("session")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings    LicenseBinding[]
  memberships SaasMembership[]
}

model LicenseBinding {
  userId      String
  licenseId   String
  fingerprint String?
  createdAt   DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  license LicenseKey @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([userId, licenseId])
  @@index([userId])
  @@index([licenseId])
}

model Order {
  id        String   @id @default(cuid())
  planId    String
  email     String?
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([email])
  @@map("order")
}

model LicenseKey {
  id           String    @id @default(cuid())
  keyHash      String    @unique
  planId       String?
  maxDownloads Int       @default(0)
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  requireLogin Boolean   @default(false)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  planLevel    String    @default("pro")
  bindings     LicenseBinding[]
}

model PdfDownloadLog {
  id            String   @id @default(cuid())
  planId        String
  ip            String?
  ok            Boolean
  reason        String?
  createdAt     DateTime @default(now())
  error         String?
  userAgent     String?
  route         String   @default("/api/pdf")
  method        String   @default("GET")
  mode          String?
  level         String?
  format        String?
  theme         String?
  pdfVersion    String?
  planVersion   String?
  budgetVersion String?
  reqsig        String?
  docSeq        String?
  pages         Int?
  bytes         Int?
  ua            String?
  extra         Json?

  @@index([planId, createdAt])
  @@index([createdAt])
}

model LicenseConsume {
  id          String   @id @default(cuid())
  licenseId   String
  planId      String
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([licenseId, fingerprint])
  @@index([planId, createdAt])
}

model PdfDownloadTokenDeny {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  planId    String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

model PdfDownloadTokenState {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  planId    String
  mode      String?
  expAt     DateTime
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, createdAt])
  @@index([revoked, expAt])
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  company   String?
  name      String?
  title     String?
  planId    String?
  intent    String
  source    String   @default("download")
  status    String   @default("new")
  score     Int      @default(0)
  note      String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([planId, createdAt])
  @@index([status])
}

model EmailVerifyCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  mode      String
  planId    String
  /// 商业模式：free / pro / enterprise，与签发 unlockToken.planLevel 对齐
  planLevel String    @default("pro")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, mode, planId, planLevel])
  @@index([expiresAt])
}

model DownloadLead {
  id           String    @id @default(cuid())
  email        String
  planId       String
  mode         String
  verifiedAt   DateTime?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([planId])
  @@index([mode])
}

model UnlockIntent {
  id        String   @id @default(cuid())
  planId    String
  createdAt DateTime @default(now())
  ip        String?
  ua        String?

  @@index([planId])
  @@index([createdAt])
}

/// 套餐升级订单（支付：pending → paid | failed | canceled）
/// status：pending | paid | failed | canceled（小写，与 API 一致）
model UpgradeOrder {
  id                String   @id @default(cuid())
  planId            String
  projectId         String?
  targetLevel       String
  status            String   @default("pending")
  amount            Int
  userId            String?
  clientFingerprint String?
  paymentProvider   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([planId, createdAt])
  @@index([status])
  @@map("upgrade_order")
}

model Project {
  id           String               @id @default(cuid())
  name         String
  clientName   String?
  industry     String?
  siteType     SiteType
  areaM2       Float?
  targetUsers  Int?
  city         String?
  budgetLevel  BudgetLevel
  deliveryMode DeliveryMode
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  description  String?
  budgets      Budget[]
  documents    DocumentExport[]
  placeholders ProductPlaceholder[]
  solution     Solution?
}

model Solution {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  summary            String
  background         String
  requirements       Json
  objectives         Json
  zoning             Json
  implementationPlan Json
  operationsPlan     Json
  riskControl        Json
  acceptanceCriteria Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProductPlaceholder {
  id                   String      @id @default(cuid())
  projectId            String
  category             String
  subCategory          String?
  specTags             Json
  quantity             Int
  priceBand            PriceBand
  recommendationReason String
  replaceable          Boolean     @default(true)
  skuId                String?
  skuName              String?
  brand                String?
  model                String?
  imageUrl             String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skuMapping           SkuMapping?
}

model Budget {
  id               String   @id @default(cuid())
  projectId        String
  currency         String   @default("CNY")
  totalEstimateMin Float
  totalEstimateMax Float
  items            Json
  assumptions      Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DocumentExport {
  id            String       @id @default(cuid())
  projectId     String
  docType       DocumentType
  fileName      String
  fileUrl       String?
  renderVersion String
  metadata      Json?
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkuMapping {
  id            String             @id @default(cuid())
  placeholderId String             @unique
  skuId         String
  skuName       String
  brand         String?
  model         String?
  imageUrl      String?
  unitPrice     Float?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  placeholder   ProductPlaceholder @relation(fields: [placeholderId], references: [id], onDelete: Cascade)
}

enum SiteType {
  office
  factory
  park
  school
  hospital
  mixed
}

enum BudgetLevel {
  low
  mid
  high
  custom
}

enum DeliveryMode {
  standard
  enterprise
  tender
}

enum PriceBand {
  low
  mid
  high
}

enum DocumentType {
  plan
  budget
  merged
  zip
}

// ═══════════════════════════════════════════════════════════
// V48 Production SaaS Foundation — Phase 1
// Tag: v48-saas-foundation-p1
//
// Relations:
//   SaasTenant -> SaasOrganization / SaasWorkspace / SaasMembership / SaasSubscription / SaasEntitlementGrant
//   SaasOrganization -> SaasWorkspace / SaasMembership
//   SaasWorkspace -> SaasMembership
//   SaasMembership -> User / SaasOrganization / SaasWorkspace
//   SaasRole -> SaasPermission (via SaasRolePermission)
//   SaasPlan -> SaasSubscription (features/quota JSON on SaasPlan)
// ═══════════════════════════════════════════════════════════

model SaasTenant {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  status     String   @default("active")
  portalType String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizations SaasOrganization[]
  workspaces    SaasWorkspace[]
  memberships   SaasMembership[]
  subscription  SaasSubscription?
  grants        SaasEntitlementGrant[]

  @@index([status])
  @@index([portalType])
  @@map("saas_tenant")
}

model SaasOrganization {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  orgType   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      SaasTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaces  SaasWorkspace[]
  memberships SaasMembership[]

  @@index([tenantId])
  @@index([tenantId, orgType])
  @@map("saas_organization")
}

model SaasWorkspace {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  name           String
  workspaceType  String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       SaasTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization SaasOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  SaasMembership[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, organizationId])
  @@map("saas_workspace")
}

model SaasMembership {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  workspaceId    String
  userId         String
  roleId         String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       SaasTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization SaasOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    SaasWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         SaasRole         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([userId])
  @@index([tenantId, organizationId])
  @@map("saas_membership")
}

model SaasRole {
  id         String   @id @default(cuid())
  tenantId   String?
  systemCode String?  @unique
  name       String
  scope      String
  portalType String?
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  permissions SaasRolePermission[]
  memberships SaasMembership[]

  @@index([tenantId])
  @@index([portalType])
  @@map("saas_role")
}

model SaasPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles SaasRolePermission[]

  @@index([resource])
  @@map("saas_permission")
}

model SaasRolePermission {
  roleId       String
  permissionId String

  role       SaasRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SaasPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("saas_role_permission")
}

model SaasPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  priceMonthly Int      @default(0)
  features     Json
  quotas       Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions SaasSubscription[]

  @@map("saas_plan")
}

model SaasSubscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  planId             String
  status             String    @default("trialing")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant SaasTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaasPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("saas_subscription")
}

model SaasEntitlementGrant {
  id        String    @id @default(cuid())
  tenantId  String
  feature   String
  enabled   Boolean   @default(true)
  quota     Int?
  used      Int       @default(0)
  expiresAt DateTime?
  source    String    @default("subscription")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant SaasTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("saas_entitlement_grant")
}
